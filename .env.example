# Copy to .env (never commit .env) and fill in real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (default database backend)
POSTGRES_DB=collabdocs
POSTGRES_USER=collabdocs
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Set to true ONLY on a machine without PostgreSQL. SQLite cannot demonstrate
# select_for_update() row locking; the concurrency tests are skipped on it.
USE_SQLITE=false

# Log level for the documents app (DEBUG, INFO, WARNING, ERROR)
DOCUMENTS_LOG_LEVEL=WARNING
